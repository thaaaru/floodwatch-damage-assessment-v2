# Non-secret settings for docker-compose.prod.yml (copy to .env next to it).
# The DB password is NOT here: it is a Docker secret at /run/floodwatch/db_password.

# CIDRs containing only the host Caddy and floodwatch-frontend container peers.
# Deployment is intentionally refused when either trust value is unset.
TRUSTED_PROXY_CIDRS=
TRUSTED_PROXY_TOKEN=

WEATHER_SOURCE=open_meteo

# ReliefWeb API v2 appname for /news. Must be pre-approved by ReliefWeb (request via
# https://apidoc.reliefweb.int/parameters#appname). Empty = ReliefWeb source disabled.
RELIEFWEB_APPNAME=

# Optional public ArcGIS key (browser): enables the "Satellite (Esri)" overlay.
# Leave empty to hide it. Restrict it to referrer https://floodwatch.teklab.dev/*.
NEXT_PUBLIC_ARCGIS_API_KEY=

# Where scripts/build_basemap.sh writes lka.pmtiles (served by floodwatch-tiles).
FLOODWATCH_TILES_DIR=/opt/floodwatch-data/tiles

# Optional server-side keys (leave empty; core rainfall/GDACS data needs none).
WEATHERAPI_KEY=
TOMTOM_API_KEY=
HERE_API_KEY=
# Dedicated server-only Maps Platform key; restrict to Places API (New),
# Geocoding, Routes, and Elevation. Empty disables paid map-context endpoints.
GOOGLE_MAPS_API_KEY=
