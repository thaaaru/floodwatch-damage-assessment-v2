# Non-secret settings for docker-compose.prod.yml (copy to .env next to it).
# The DB password is NOT here: it is a Docker secret at /run/floodwatch/db_password.

# Public browser key, inlined into the JS bundle. Restrict it in Google Cloud:
# HTTP referrer https://floodwatch.teklab.dev/*, APIs: Maps JavaScript + Places.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

WEATHER_SOURCE=open_meteo

# Optional server-side keys (leave empty; core rainfall/GDACS data needs none).
OPENWEATHERMAP_API_KEY=
WEATHERAPI_KEY=
TOMTOM_API_KEY=
HERE_API_KEY=
