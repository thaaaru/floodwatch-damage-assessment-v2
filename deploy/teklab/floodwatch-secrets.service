# Install: /etc/systemd/system/floodwatch-secrets.service
# Script:  /usr/local/sbin/floodwatch-secrets (from deploy/teklab/floodwatch-secrets.sh)
[Unit]
Description=Decrypt FloodWatch secrets into /run/floodwatch
After=local-fs.target
# Files must exist before dockerd restarts the floodwatch containers on boot.
Before=docker.service
ConditionPathExists=/etc/age/tencent.key

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/floodwatch-secrets

[Install]
WantedBy=multi-user.target docker.service
