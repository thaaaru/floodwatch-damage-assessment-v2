# Database
DATABASE_URL=postgresql://user:password@localhost:5432/floodwatch

# Twilio SMS
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# API URLs
GDACS_API_URL=https://www.gdacs.org/gdacsapi/api/events/geteventlist/SEARCH
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
TOMORROW_IO_API_KEY=optional_backup_key
# Optional: Google Flood Forecasting v1 requires waitlist approval and an enabled
# Google Cloud project. Leave empty to report the source as disabled.
GOOGLE_FLOODS_API_KEY=
# Optional server-only key for Places, Geocoding, Routes, and Elevation.
# Leave empty to return 503 from paid map-context endpoints.
GOOGLE_MAPS_API_KEY=


# Application
ALERT_CHECK_INTERVAL_MINUTES=15
FRONTEND_URL=https://weather.hackandbuild.dev
DEBUG=false
